# Which data source to use: yahoo (no key) | borsdata | finnhub | fmp | mock (offline demo data)
# Tickers a provider doesn't have (e.g. an ETF missing in Börsdata) fall back to Yahoo automatically.
PROVIDER=yahoo

# Free keys: https://finnhub.io/register  ·  https://site.financialmodelingprep.com/developer/docs
# Börsdata: Pro+ membership → Min sida → API → apply for a key
BORSDATA_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# Currency to convert prices, market cap and dividends into (shown next to the original)
BASE_CURRENCY=SEK

# Risk-free rate in percent, used for the Sharpe ratio
RISK_FREE_RATE=2

# Cache lifetimes – raise these to save free-tier quota
QUOTE_TTL_SECONDS=60
HISTORY_TTL_HOURS=12

PORT=8787
